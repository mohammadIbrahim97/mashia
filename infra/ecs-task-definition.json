{
  "family": "mashia-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "mashia-backend",
      "image": "ACCOUNT_ID.dkr.ecr.me-south-1.amazonaws.com/mashia-backend:latest",
      "portMappings": [
        {
          "containerPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT", "value": "3000" }
      ],
      "secrets": [
        { "name": "DB_HOST", "valueFrom": "arn:aws:ssm:me-south-1:ACCOUNT_ID:parameter/mashia/db-host" },
        { "name": "DB_PASSWORD", "valueFrom": "arn:aws:ssm:me-south-1:ACCOUNT_ID:parameter/mashia/db-password" },
        { "name": "JWT_SECRET", "valueFrom": "arn:aws:ssm:me-south-1:ACCOUNT_ID:parameter/mashia/jwt-secret" },
        { "name": "JWT_REFRESH_SECRET", "valueFrom": "arn:aws:ssm:me-south-1:ACCOUNT_ID:parameter/mashia/jwt-refresh-secret" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/mashia-backend",
          "awslogs-region": "me-south-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
